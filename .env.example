# ═══════════════════════════════════════════════════════════════
# Money Mngr PWA - Environment Configuration
# Copy this file to .env.local and fill in your values
# ═══════════════════════════════════════════════════════════════

# === Google Sheets Backup (Server-side) ===
# Required for backup/restore functionality
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id-here

# === Google OAuth (required for login) ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === Google Drive (for snapshots - optional) ===
# Enable the Google Drive API in your Google Cloud Console
# Uses the same service account as Google Sheets

# === NextAuth ===
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# === LLM API Keys (for AI-powered SMS parsing) ===
# These are client-side accessible (NEXT_PUBLIC_ prefix)
# At least one key is required for AI features to work
# Keys are tried in order: Gemini -> OpenAI -> Claude

# Google Gemini API Key (get from https://ai.google.dev/)
NEXT_PUBLIC_GEMINI_API_KEY=

# OpenAI API Key (get from https://platform.openai.com/api-keys)
NEXT_PUBLIC_OPENAI_API_KEY=

# Anthropic Claude API Key (get from https://console.anthropic.com/)
NEXT_PUBLIC_CLAUDE_API_KEY=

# === App Settings ===
NEXT_PUBLIC_APP_NAME="Money Mngr"
